PROJECT_NAME=Predictive Maintenance Hub
API_V1_STR=/api
ENVIRONMENT=development
SECRET_KEY=change-this-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use DATABASE_URL in managed hosting, or the DB_* values below for local PostgreSQL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=predictive_maintenance_hub
DB_USER=postgres
DB_PASSWORD=
DB_MIN_CONN=1
DB_MAX_CONN=10
AUTO_CREATE_TABLES=true

GEMINI_API_KEY=
